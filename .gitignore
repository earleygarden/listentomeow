# ══════════════════════════════════════════════════════════════
# 听喵说 · 不要上传的东西
# ══════════════════════════════════════════════════════════════

# ── 数据与隐私 ────────────────────────────────────────────────
# 训练/测试数据集：第三方数据，各有许可，体积约 780MB
data/*
# 例外：OOD 护栏（kNN 距离判断「这段声音我熟不熟」）依赖这份缓存
!data/_emb_cache/
data/_emb_cache/*
!data/_emb_cache/emb_ast_mean.npy

# 用户录的喵语存档（真实猫叫录音 + 分析结果，隐私，绝不上传）
data/uploads/

# ── 模型权重 ─────────────────────────────────────────────────
# AST 骨干 345MB，超过 GitHub 单文件 100MB 硬限制；获取方式见 README
models/ast_embed.onnx
models/_未使用（下载未完成）/

# ── 本机痕迹 ─────────────────────────────────────────────────
models/train_gate.log

# ── 历史备份（本地留着就好，git 本身就是版本管理）────────────
_历史版本_*
web/_历史版本_*
web/_旧版UI备份.html

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 系统 ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
node_modules/
